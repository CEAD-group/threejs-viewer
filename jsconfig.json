{
  "compilerOptions": {
    "checkJs": true,
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable", "WebWorker"]
  },
  "include": ["src/threejs_viewer/viewer/**/*.js"],
  "exclude": [
    "node_modules",
    "src/threejs_viewer/viewer.html",
    "src/threejs_viewer/viewer/static/draco"
  ]
}
